---
import { services } from '../data/services';
---
<header class="header"><div class="container header-inner">
 <a href="/#inicio" class="brand" aria-label="Estudio Ghetti · Inicio"><span class="brand-mark"><img src="/logo.png" alt="" width="138" height="138" /></span><span class="wordmark">ESTUDIO GHETTI<small>ESTUDIO JURÍDICO</small></span></a>
 <button class="menu-toggle" aria-controls="main-nav" aria-expanded="false">Menú</button>
 <nav id="main-nav" class="nav" aria-label="Navegación principal">
  <details class="services-menu"><summary>Servicios <span aria-hidden="true">⌄</span></summary><ul class="services-dropdown">{services.map(s => <li><a href={'/#'+s.id}>{s.title}</a></li>)}</ul></details>
  <a href="/articulos/">Artículos</a><a href="/#sobre-mi">El estudio</a><a href="/#contacto">Contacto</a>
  <a href="https://wa.me/5491169380777" target="_blank" rel="noopener" class="btn btn-primary">Consultá por WhatsApp <span aria-hidden="true">↗</span></a>
 </nav>
</div></header>
<style>
.header{position:sticky;top:0;z-index:100;background:var(--marfil);border-bottom:1px solid var(--arena)}
.header-inner{min-height:100px;display:flex;align-items:center;justify-content:space-between;gap:24px}
.brand{display:flex;align-items:center;gap:16px;flex-shrink:0}.brand-mark{width:61px;height:58px;overflow:hidden;position:relative}
.brand-mark img{position:absolute;width:138px;max-width:none;height:auto;left:-38px;top:-28px}
.wordmark{font:22px Georgia,serif;letter-spacing:1px}.wordmark small{display:block;font:9px Arial,sans-serif;letter-spacing:2.5px;margin-top:7px}
.nav{display:flex;align-items:center;gap:25px;font-size:13px}.nav>a:not(.btn),summary{padding:12px 0}.nav a:hover{text-decoration:underline;text-underline-offset:5px}
.services-menu{position:relative}summary{cursor:pointer;list-style:none;display:flex;gap:10px;align-items:center}summary::-webkit-details-marker{display:none}
.services-dropdown{position:absolute;top:100%;left:-20px;min-width:235px;list-style:none;background:var(--marfil);border:1px solid var(--arena);padding:10px 0}
.services-dropdown a{display:block;padding:12px 20px}.services-dropdown a:hover{background:var(--arena)}
.menu-toggle{display:none;padding:10px 14px;border:1px solid var(--arena);color:var(--bordo);background:transparent;cursor:pointer}
@media(max-width:1100px){
 .header-inner{min-height:84px}.menu-toggle{display:block}
 .nav{display:none;position:absolute;top:100%;left:0;right:0;padding:20px 6% 28px;background:var(--marfil);border-bottom:1px solid var(--arena);max-height:calc(100dvh - 84px);overflow-y:auto}
 .nav.open{display:flex;flex-direction:column;align-items:stretch;gap:8px}.services-dropdown{position:static;border:0;border-left:1px solid var(--arena);margin:6px 0 12px}
 .brand{gap:10px}.wordmark{font-size:18px}.brand-mark{width:47px;height:47px}.brand-mark img{width:110px;left:-30px;top:-22px}
}
@media(max-width:360px){.wordmark{font-size:15px}.wordmark small{font-size:8px}.header-inner{gap:10px}}
</style>
<script>
const button=document.querySelector<HTMLButtonElement>('.menu-toggle')!;
const nav=document.querySelector<HTMLElement>('#main-nav')!;
const services=document.querySelector<HTMLDetailsElement>('.services-menu')!;
function closeMenu(){nav.classList.remove('open');button.setAttribute('aria-expanded','false');button.textContent='Menú';services.open=false}
button.addEventListener('click',()=>{const open=nav.classList.toggle('open');button.setAttribute('aria-expanded',String(open));button.textContent=open?'Cerrar':'Menú';if(!open)services.open=false});
nav.querySelectorAll('a').forEach(a=>a.addEventListener('click',closeMenu));
document.addEventListener('keydown',e=>{if(e.key!=='Escape')return;if(services.open){services.open=false;services.querySelector('summary')?.focus()}else if(nav.classList.contains('open')){closeMenu();button.focus()}});
document.addEventListener('click',e=>{if(e.target instanceof Node&&!document.querySelector('.header')?.contains(e.target))closeMenu()});
services.addEventListener('focusout',e=>{if(!services.contains(e.relatedTarget as Node|null))services.open=false});
window.matchMedia('(max-width:1100px)').addEventListener('change',closeMenu);
</script>
