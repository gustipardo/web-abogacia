<script>
  // Content is visible by default. Only a supported, running script prepares fades.
  const preference = window.matchMedia('(prefers-reduced-motion: reduce)');
  const animations = new Map<HTMLElement, Animation>();
  const seen = new WeakSet<Element>();
  const hero = [...document.querySelectorAll<HTMLElement>('.hero-grid > div > *, .hero-grid > .portrait')];
  const sections = [...document.querySelectorAll<HTMLElement>([
    '.section-head', '.services > .service', '.feature-grid > *',
    '.multas-grid > *', '.civil-grid > *', '.about-grid > *',
    '.articles-header', '.articles-grid > *', '.questions-grid > *',
    '.contact-grid > *', '.articulos-hero .container',
    '.tag-group-title', '.articulo-card',
  ].join(','))];
  let observer: IntersectionObserver | undefined;
  let navigationFrame = 0;

  function anchorTarget() {
    return location.hash ? document.getElementById(location.hash.slice(1)) : null;
  }

  function expose(target: Element | null) {
    if (!target) return;
    animations.forEach((animation, element) => {
      if (element.contains(target) || target.contains(element)) {
        seen.add(element);
        observer?.unobserve(element);
        animation.cancel();
        animations.delete(element);
      }
    });
  }

  function cancelAll() {
    cancelAnimationFrame(navigationFrame);
    observer?.disconnect();
    animations.forEach(animation => animation.cancel());
    animations.clear();
  }

  function prepare(element: HTMLElement, delay: number, isHero = false) {
    if (seen.has(element)) return;
    const rect = element.getBoundingClientRect();
    const target = anchorTarget();
    if (rect.top < 0 || element.contains(document.activeElement) ||
        (target && (element.contains(target) || target.contains(element)))) {
      seen.add(element);
      return;
    }
    // Reduced motion keeps a gentle dissolve, without any spatial movement.
    const reduced = preference.matches;
    const animation = element.animate(reduced ? [
      { opacity: 0 },
      { opacity: 1 },
    ] : [
      { opacity: 0, transform: 'translateY(26px)' },
      { opacity: 1, transform: 'translateY(0)' },
    ], {
      duration: isHero ? 2400 : reduced ? 900 : 1100,
      delay: reduced && !isHero ? Math.min(delay, 160) : delay,
      easing: isHero ? 'cubic-bezier(.4,0,.2,1)' : 'cubic-bezier(.22,.61,.36,1)',
      fill: 'both',
    });
    animations.set(element, animation);
    // Remove the finished effect so hover states and ordinary layout remain native.
    animation.addEventListener('finish', () => {
      animations.delete(element);
      animation.cancel();
    }, { once: true });
    if (isHero && rect.top < window.innerHeight) {
      seen.add(element);
    } else {
      animation.pause();
      animation.currentTime = 0;
      observer?.observe(element);
    }
  }

  function observe() {
    cancelAll();
    if (!('IntersectionObserver' in window) ||
        !('animate' in Element.prototype)) return;
    observer = new IntersectionObserver(entries => {
      entries.forEach(entry => {
        if (!entry.isIntersecting) return;
        const element = entry.target as HTMLElement;
        observer?.unobserve(element);
        seen.add(element);
        animations.get(element)?.play();
      });
    }, { threshold: 0.08, rootMargin: '0px 0px -24px 0px' });
    try {
      // First the heading, then the supporting text, actions and restrained portrait.
      hero.forEach((element, index) => prepare(element, Math.min(index * 220, 880), true));
      sections.forEach(element => {
        const siblings = [...(element.parentElement?.children ?? [])];
        prepare(element, Math.min(siblings.indexOf(element), 3) * 130);
      });
    } catch {
      // A browser limitation must never leave text or controls hidden.
      cancelAll();
    }
  }

  function revealDestination(target: HTMLElement) {
    cancelAnimationFrame(navigationFrame);
    expose(target);
    const started = performance.now();
    let previousTop = target.getBoundingClientRect().top;
    let stableSince = started;
    function arrive(now: number) {
      const top = target.getBoundingClientRect().top;
      if (Math.abs(top - previousTop) > 1) stableSince = now;
      previousTop = top;
      // Let native anchor scrolling finish before revealing the destination.
      if (now - stableSince < 100 && now - started < 1600) {
        navigationFrame = requestAnimationFrame(arrive);
        return;
      }
      if (!('animate' in Element.prototype)) return;
      const candidates = [...target.querySelectorAll<HTMLElement>('h1, h2, h3, p, li, .btn, .portrait')];
      const elements = candidates.filter(element =>
        !candidates.some(parent => parent !== element && parent.contains(element)));
      try {
        elements.forEach((element, index) => {
          if (element.contains(document.activeElement)) return;
          const rect = element.getBoundingClientRect();
          if (rect.bottom <= 0 || rect.top >= innerHeight) return;
          const animation = element.animate(preference.matches ? [
            { opacity: 0 }, { opacity: 1 },
          ] : [
            { opacity: 0, transform: 'translateY(12px)' },
            { opacity: 1, transform: 'translateY(0)' },
          ], {
            duration: 650, delay: Math.min(index * 55, 220),
            easing: 'cubic-bezier(.4,0,.2,1)', fill: 'both',
          });
          animations.set(element, animation);
          animation.addEventListener('finish', () => {
            if (animations.get(element) === animation) animations.delete(element);
            animation.cancel();
          }, { once: true });
        });
      } catch { expose(target); }
    }
    navigationFrame = requestAnimationFrame(arrive);
  }

  // Preserve native history, keyboard navigation and modified/new-tab clicks.
  document.addEventListener('click', event => {
    if (event.defaultPrevented || event.button !== 0 || event.ctrlKey || event.metaKey || event.shiftKey || event.altKey) return;
    const link = (event.target as Element).closest<HTMLAnchorElement>('a[href]');
    if (!link || link.hasAttribute('download') || (link.target && link.target !== '_self')) return;
    const url = new URL(link.href, location.href);
    if (url.origin !== location.origin || url.pathname !== location.pathname || url.search !== location.search || !url.hash) return;
    const target = document.getElementById(url.hash.slice(1));
    if (target && target.matches('section')) revealDestination(target);
  });

  preference.addEventListener('change', observe);
  document.addEventListener('focusin', event => expose(event.target as Element));
  window.addEventListener('hashchange', () => {
    const target = anchorTarget();
    if (target?.matches('section')) revealDestination(target);
    else expose(target);
  });
  window.addEventListener('beforeprint', cancelAll);
  window.addEventListener('pagehide', cancelAll);
  window.addEventListener('pageshow', event => { if (event.persisted) observe(); });
  observe();
  const initialTarget = anchorTarget();
  if (initialTarget?.matches('section')) revealDestination(initialTarget);
</script>
