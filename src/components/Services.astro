---
import { services } from '../data/services';
---
<section id="servicios" class="section"><div class="container">
 <div class="section-head"><div><p class="section-label">Áreas de práctica</p><h2 class="section-title">Un enfoque para<br />cada situación</h2></div><p>Contame qué necesitás. Revisamos tu caso y conversamos sobre los pasos a seguir.</p></div>
 <div class="services">{services.map((s,i)=><a class="service" href={'#'+s.id}><span class="number">{String(i+1).padStart(2,'0')}</span><h3>{s.title}</h3><p>{s.description}</p><span class="arrow" aria-hidden="true">↗</span></a>)}</div>
</div></section>
<style>
.section-head{display:flex;justify-content:space-between;align-items:end;gap:50px;margin-bottom:40px}.section-head>p{max-width:320px;font-size:14px;padding-bottom:22px}
.services{border-top:1px solid var(--arena)}.service{display:grid;grid-template-columns:45px 1fr 1fr 35px;gap:22px;align-items:center;padding:30px 0;border-bottom:1px solid var(--arena)}
.number{font:400 18px var(--font-serif);color:var(--oliva)}h3{font-size:28px}.service p{font-size:14px;max-width:360px}.arrow{font-size:28px}
.service:hover h3{text-decoration:underline;text-decoration-thickness:1px;text-underline-offset:6px}
@media(max-width:700px){.section-head{display:block;margin-bottom:24px}.service{grid-template-columns:24px 1fr 24px;gap:14px;padding:25px 0}h3{font-size:25px}.service p{grid-column:2;grid-row:2}.arrow{grid-column:3;grid-row:1}}
</style>
